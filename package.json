{
  "name": "slimetiktok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, server-authoritative interactive livestream game",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file=.env dist/src/server/main.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js && npm run test:bridges",
    "simulate": "node --env-file=.env scripts/send-event.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "bridge": "node --env-file=.env bridges/tiktok.mjs",
    "stream": "node --env-file=.env scripts/stream-worker.mjs",
    "test:bridges": "node --test tests/bridge.test.mjs",
    "soak": "npm run build && node --expose-gc scripts/soak.mjs",
    "live": "node --env-file=.env --env-file=.env.live dist/src/server/main.js",
    "bridge:live": "node --env-file=.env --env-file=.env.live bridges/tiktok.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0",
    "three": "0.187.0",
    "typescript": "5.8.3"
  }
}
