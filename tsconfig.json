{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "rootDir": ".", "outDir": "dist", "sourceMap": true,
    "types": ["node"], "verbatimModuleSyntax": true, "allowJs": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "bridges/chat.mjs"],
  "exclude": ["node_modules", "dist"]
}
