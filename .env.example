# Generate real independent secrets with: npm run setup
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_TOKEN=
WEBHOOK_SECRET=
DATA_DIR=./data
MODE=demo
# Text-to-speech for the character. none = captions only. fal = a fal.ai hosted model (default xai/tts/v1,
# voice rex; key from FAL_KEY or TTS_API_KEY). http = POST {text,voice,language} to TTS_URL, get audio
# bytes back (fits a small proxy for any vendor). elevenlabs / openai use their REST APIs.
TTS_PROVIDER=none
# Example: TTS_PROVIDER=fal, TTS_MODEL=xai/tts/v1, TTS_VOICE=sirius, FAL_KEY=<your fal.ai key>
TTS_API_KEY=
TTS_VOICE=
TTS_MODEL=
TTS_URL=
FAL_KEY=
# How long a new line may wait for its audio before it goes out as a caption only (fal: ~3-5 s).
TTS_WAIT_MS=4000
# Paid synthesis stops for the day after this many characters; captions keep working.
TTS_DAILY_CHARS=100000
# Voice every fixed line once at startup, in the background (cached on disk, so later starts are free).
TTS_PREWARM=true
# Parallel syntheses (1-6).
TTS_CONCURRENCY=2
# Real event bridge. Never expose its secret or stream key to the browser.
TIKTOK_USERNAME=
TIKTOK_HOST_ID=
TIKTOK_ROOM_ID=
SIGN_API_KEY=
CONNECTOR_LICENSE_ACK=false
INGEST_URL=http://127.0.0.1:3000/api/ingest
# Optional TikFinity Desktop bridge (normally on a Windows operator machine).
TIKFINITY_WS=ws://127.0.0.1:21213/
# Chat text never leaves the bridge unless this is true (needed for the panel's chat echo). Commands always pass.
FORWARD_CHAT=false
BRIDGE_PROVIDER=tiktok
# Optional broadcasting worker; does not obtain LIVE/RTMP access for you.
BROADCAST_ENABLED=false
BROADCAST_URL=http://127.0.0.1:3000/overlay
RTMP_URL=
STREAM_WIDTH=720
STREAM_HEIGHT=1280
STREAM_FPS=30
STREAM_BITRATE=2500k
CHROMIUM_BIN=chromium
FFMPEG_BIN=ffmpeg
DISPLAY=:99
# silent keeps the old silent AAC track; pulse records the overlay's voice and sounds via PulseAudio.
BROADCAST_AUDIO=silent

# Optional infrastructure
DOMAIN=localhost
BACKUP_DIR=./backups
CHROMIUM_NO_SANDBOX=false
BROADCAST_STARTUP_GRACE_SECONDS=120
